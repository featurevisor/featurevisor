{
  "description": "Show cookie banner to users from the Netherlands",
  "tags": ["all"],
  "bucketBy": "userId",
  "rules": {
    "staging": [
      {
        "key": "everyone",
        "conditions": "*",
        "percentage": 100
      }
    ],
    "production": [
      {
        "key": "nl",
        "conditions": ["netherlands"],
        "percentage": 100
      },
      {
        "key": "everyone",
        "conditions": "*",
        "percentage": 0
      }
    ]
  }
}
