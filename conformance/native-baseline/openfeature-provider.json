{
  "kind": "featurevisor.openfeature-provider",
  "schemaVersion": 1,
  "datafile": {
    "schemaVersion": "2",
    "revision": "provider-conformance",
    "segments": {},
    "features": {
      "checkout": {
        "bucketBy": "userId",
        "variations": [{ "value": "on", "variables": { "config": "{\"enabled\":true}", "nullable": "null" } }],
        "variablesSchema": {
          "config": { "type": "json", "defaultValue": "{}" },
          "nullable": { "type": "json", "defaultValue": "null" }
        },
        "force": [{ "conditions": { "attribute": "userId", "operator": "equals", "value": "forced" }, "enabled": true, "variation": "on" }],
        "traffic": [{ "key": "all", "segments": "*", "percentage": 100000, "variation": "on" }]
      },
      "disabled": {
        "bucketBy": "userId",
        "variations": [],
        "force": [{ "conditions": { "attribute": "blocked", "operator": "equals", "value": true }, "enabled": false }],
        "traffic": []
      },
      "accountTargeted": {
        "bucketBy": "accountId",
        "variations": [],
        "force": [{ "conditions": { "attribute": "accountId", "operator": "equals", "value": "" }, "enabled": true }],
        "traffic": []
      },
      "targetOnly": {
        "bucketBy": "userId",
        "variations": [],
        "force": [{ "conditions": { "attribute": "userId", "operator": "equals", "value": "forced" }, "enabled": true }],
        "traffic": []
      }
    },
    "variables": {
      "settings": { "type": "json", "defaultValue": "{\"region\":\"eu\"}" },
      "nullable": { "type": "json", "defaultValue": "null" }
    }
  },
  "cases": [
    { "name": "forced flag", "flagKey": "checkout", "type": "boolean", "default": false, "context": { "targetingKey": "forced" }, "expected": { "value": true, "reason": "TARGETING_MATCH" } },
    { "name": "variation selector", "flagKey": "checkout:variation", "type": "string", "default": "fallback", "context": { "targetingKey": "forced" }, "expected": { "value": "on", "reason": "TARGETING_MATCH", "variant": "on" } },
    { "name": "feature JSON", "flagKey": "checkout:config", "type": "object", "default": {}, "context": { "targetingKey": "forced" }, "expected": { "value": { "enabled": true } } },
    { "name": "global JSON", "flagKey": "variable:settings", "type": "object", "default": {}, "context": {}, "expected": { "value": { "region": "eu" }, "reason": "DEFAULT" } },
    { "name": "feature JSON null", "flagKey": "checkout:nullable", "type": "object", "default": { "fallback": true }, "context": { "targetingKey": "forced" }, "expected": { "value": { "fallback": true } } },
    { "name": "global JSON null", "flagKey": "variable:nullable", "type": "object", "default": { "fallback": true }, "context": {}, "expected": { "value": { "fallback": true }, "reason": "DEFAULT" } },
    { "name": "disabled flag", "flagKey": "disabled", "type": "boolean", "default": true, "context": { "blocked": true }, "expected": { "value": false, "reason": "TARGETING_MATCH" } },
    { "name": "missing flag", "flagKey": "missing", "type": "boolean", "default": false, "context": {}, "expected": { "value": false, "reason": "ERROR", "errorCode": "FLAG_NOT_FOUND" } },
    { "name": "type mismatch", "flagKey": "checkout:config", "type": "string", "default": "fallback", "context": { "targetingKey": "forced" }, "expected": { "value": "fallback", "reason": "ERROR", "errorCode": "TYPE_MISMATCH" } }
  ],
  "targetingCases": [
    { "name": "absent preserves field", "context": { "userId": "forced" }, "expectedUserId": "forced", "expectedValue": true },
    { "name": "empty overrides field", "context": { "targetingKey": "", "userId": "forced" }, "expectedUserId": "", "expectedValue": false },
    { "name": "nonempty overrides field", "context": { "targetingKey": "other", "userId": "forced" }, "expectedUserId": "other", "expectedValue": false }
  ],
  "customTargetingCase": { "flagKey": "accountTargeted", "context": { "targetingKey": "", "accountId": "old" }, "targetingKeyField": "accountId", "expectedValue": true, "expectedReason": "TARGETING_MATCH" }
}
