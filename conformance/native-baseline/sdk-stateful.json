{
  "kind": "featurevisor.sdk-stateful",
  "schemaVersion": 1,
  "cases": [
    {
      "name": "partial and full variable updates propagate through same hash dependents",
      "initial": {
        "datafile": {
          "schemaVersion": "2",
          "revision": "initial",
          "segments": {},
          "features": {
            "dependent": {
              "hash": "dependent",
              "bucketBy": "userId",
              "requiredVariables": [{ "variable": "gate", "operator": "equals", "value": true }],
              "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
            },
            "transitive": {
              "hash": "transitive",
              "bucketBy": "userId",
              "requiredFeatures": ["dependent"],
              "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
            }
          },
          "variables": {
            "gate": { "hash": "gate-1", "type": "boolean", "defaultValue": false },
            "message": {
              "hash": "message",
              "type": "string",
              "defaultValue": "ready",
              "disabledValue": "blocked",
              "requiredVariables": [{ "variable": "gate", "operator": "equals", "value": true }]
            }
          }
        }
      },
      "operations": [
        {
          "action": "setDatafile",
          "target": "root",
          "replace": false,
          "datafile": {
            "schemaVersion": "2",
            "revision": "partial",
            "segments": {},
            "features": {},
            "variables": {
              "gate": { "hash": "gate-2", "type": "boolean", "defaultValue": true }
            }
          },
          "expect": {
            "events": [
              {
                "target": "root",
                "name": "datafile_set",
                "details": {
                  "revision": "partial",
                  "previousRevision": "initial",
                  "revisionChanged": true,
                  "features": ["dependent", "transitive"],
                  "variables": ["gate", "message"],
                  "replaced": false
                }
              }
            ],
            "results": [
              { "target": "root", "method": "isEnabled", "args": ["dependent"], "value": true },
              { "target": "root", "method": "isEnabled", "args": ["transitive"], "value": true },
              { "target": "root", "method": "getVariable", "args": ["message"], "value": "ready" }
            ]
          }
        },
        {
          "action": "setDatafile",
          "target": "root",
          "replace": true,
          "datafile": {
            "schemaVersion": "2",
            "revision": "full",
            "segments": {},
            "features": {
              "dependent": {
                "hash": "dependent",
                "bucketBy": "userId",
                "requiredVariables": [{ "variable": "gate", "operator": "equals", "value": true }],
                "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
              },
              "transitive": {
                "hash": "transitive",
                "bucketBy": "userId",
                "requiredFeatures": ["dependent"],
                "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
              }
            },
            "variables": {
              "gate": { "hash": "gate-3", "type": "boolean", "defaultValue": false },
              "message": {
                "hash": "message",
                "type": "string",
                "defaultValue": "ready",
                "disabledValue": "blocked",
                "requiredVariables": [{ "variable": "gate", "operator": "equals", "value": true }]
              }
            }
          },
          "expect": {
            "events": [
              {
                "target": "root",
                "name": "datafile_set",
                "details": {
                  "revision": "full",
                  "previousRevision": "partial",
                  "revisionChanged": true,
                  "features": ["dependent", "transitive"],
                  "variables": ["gate", "message"],
                  "replaced": true
                }
              }
            ],
            "results": [
              { "target": "root", "method": "isEnabled", "args": ["dependent"], "value": false },
              { "target": "root", "method": "isEnabled", "args": ["transitive"], "value": false },
              { "target": "root", "method": "getVariable", "args": ["message"], "value": "blocked" }
            ]
          }
        }
      ]
    },
    {
      "name": "partial and full updates use new and old dependency graphs",
      "initial": {
        "datafile": {
          "schemaVersion": "2",
          "revision": "initial",
          "segments": {},
          "features": {
            "dependent": {
              "hash": "dependent",
              "bucketBy": "userId",
              "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
            },
            "transitive": {
              "hash": "transitive",
              "bucketBy": "userId",
              "requiredFeatures": ["dependent"],
              "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
            }
          },
          "variables": {
            "gate": { "hash": "gate-1", "type": "boolean", "defaultValue": false },
            "message": { "hash": "message", "type": "string", "defaultValue": "ready" }
          }
        }
      },
      "operations": [
        {
          "action": "setDatafile",
          "target": "root",
          "replace": false,
          "datafile": {
            "schemaVersion": "2",
            "revision": "added",
            "segments": {},
            "features": {
              "dependent": {
                "hash": "dependent",
                "bucketBy": "userId",
                "requiredVariables": [{ "variable": "gate", "operator": "equals", "value": true }],
                "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
              }
            },
            "variables": {
              "gate": { "hash": "gate-2", "type": "boolean", "defaultValue": false },
              "message": {
                "hash": "message",
                "type": "string",
                "defaultValue": "ready",
                "disabledValue": "blocked",
                "requiredVariables": [{ "variable": "gate", "operator": "equals", "value": true }]
              }
            }
          },
          "expect": {
            "events": [
              {
                "target": "root",
                "name": "datafile_set",
                "details": {
                  "revision": "added",
                  "previousRevision": "initial",
                  "revisionChanged": true,
                  "features": ["dependent", "transitive"],
                  "variables": ["gate", "message"],
                  "replaced": false
                }
              }
            ],
            "results": [
              { "target": "root", "method": "isEnabled", "args": ["dependent"], "value": false },
              { "target": "root", "method": "getVariable", "args": ["message"], "value": "blocked" }
            ]
          }
        },
        {
          "action": "setDatafile",
          "target": "root",
          "replace": true,
          "datafile": {
            "schemaVersion": "2",
            "revision": "removed",
            "segments": {},
            "features": {
              "dependent": {
                "hash": "dependent",
                "bucketBy": "userId",
                "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
              },
              "transitive": {
                "hash": "transitive",
                "bucketBy": "userId",
                "requiredFeatures": ["dependent"],
                "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
              }
            },
            "variables": {
              "gate": { "hash": "gate-3", "type": "boolean", "defaultValue": false },
              "message": { "hash": "message", "type": "string", "defaultValue": "ready" }
            }
          },
          "expect": {
            "events": [
              {
                "target": "root",
                "name": "datafile_set",
                "details": {
                  "revision": "removed",
                  "previousRevision": "added",
                  "revisionChanged": true,
                  "features": ["dependent", "transitive"],
                  "variables": ["gate", "message"],
                  "replaced": true
                }
              }
            ],
            "results": [
              { "target": "root", "method": "isEnabled", "args": ["dependent"], "value": true },
              { "target": "root", "method": "getVariable", "args": ["message"], "value": "ready" }
            ]
          }
        }
      ]
    },
    {
      "name": "rejected JSON preserves previous state",
      "initial": {
        "datafile": {
          "schemaVersion": "2",
          "revision": "stable",
          "segments": {},
          "features": {
            "stable": {
              "hash": "stable",
              "bucketBy": "userId",
              "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
            }
          }
        }
      },
      "operations": [
        {
          "action": "setDatafile",
          "target": "root",
          "replace": false,
          "datafile": "{not JSON",
          "expect": {
            "error": { "code": "invalid_datafile" },
            "events": [],
            "results": [
              { "target": "root", "method": "getRevision", "args": [], "value": "stable" },
              { "target": "root", "method": "isEnabled", "args": ["stable"], "value": true }
            ]
          }
        }
      ]
    },
    {
      "name": "root and child sticky payloads stay isolated",
      "initial": {
        "datafile": {
          "schemaVersion": "2",
          "revision": "sticky",
          "segments": {},
          "features": {
            "flag": {
              "hash": "flag",
              "bucketBy": "userId",
              "variablesSchema": {
                "message": { "type": "string", "defaultValue": "default-feature" }
              },
              "traffic": [{ "key": "all", "segments": "*", "percentage": 100000 }]
            }
          },
          "variables": {
            "message": { "hash": "message", "type": "string", "defaultValue": "default-global" }
          }
        }
      },
      "operations": [
        {
          "action": "spawn",
          "parent": "root",
          "target": "child",
          "context": { "tenant": "child" },
          "options": {
            "stickyFeatures": { "flag": { "enabled": false } },
            "stickyVariables": { "message": "child-global" }
          },
          "expect": {
            "events": [],
            "results": [
              { "target": "root", "method": "isEnabled", "args": ["flag"], "value": true },
              { "target": "child", "method": "isEnabled", "args": ["flag"], "value": false },
              {
                "target": "root",
                "method": "getVariable",
                "args": ["message"],
                "value": "default-global"
              },
              {
                "target": "child",
                "method": "getVariable",
                "args": ["message"],
                "value": "child-global"
              }
            ]
          }
        },
        {
          "action": "setStickyFeatures",
          "target": "root",
          "replace": true,
          "stickyFeatures": {
            "flag": { "enabled": true, "variables": { "message": "root-feature" } }
          },
          "expect": {
            "events": [
              {
                "target": "root",
                "name": "sticky_features_set",
                "details": { "features": ["flag"], "replaced": true }
              }
            ],
            "results": [
              {
                "target": "root",
                "method": "getVariable",
                "args": ["flag", "message"],
                "value": "root-feature"
              },
              { "target": "child", "method": "isEnabled", "args": ["flag"], "value": false }
            ]
          }
        },
        {
          "action": "setStickyFeatures",
          "target": "child",
          "replace": true,
          "stickyFeatures": {
            "flag": { "enabled": true, "variables": { "message": "child-feature" } }
          },
          "expect": {
            "events": [
              {
                "target": "child",
                "name": "sticky_features_set",
                "details": { "features": ["flag"], "replaced": true }
              }
            ],
            "results": [
              {
                "target": "root",
                "method": "getVariable",
                "args": ["flag", "message"],
                "value": "root-feature"
              },
              {
                "target": "child",
                "method": "getVariable",
                "args": ["flag", "message"],
                "value": "child-feature"
              },
              {
                "target": "root",
                "method": "getVariable",
                "args": ["message"],
                "value": "default-global"
              },
              {
                "target": "child",
                "method": "getVariable",
                "args": ["message"],
                "value": "child-global"
              }
            ]
          }
        },
        {
          "action": "setStickyVariables",
          "target": "child",
          "replace": true,
          "stickyVariables": { "message": "child-global-updated" },
          "expect": {
            "events": [
              {
                "target": "child",
                "name": "sticky_variables_set",
                "details": { "variables": ["message"], "replaced": true }
              }
            ],
            "results": [
              {
                "target": "root",
                "method": "getVariable",
                "args": ["message"],
                "value": "default-global"
              },
              {
                "target": "child",
                "method": "getVariable",
                "args": ["message"],
                "value": "child-global-updated"
              }
            ]
          }
        }
      ]
    }
  ]
}
