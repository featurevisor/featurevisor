{
  "kind": "featurevisor.sdk-sections",
  "schemaVersion": 1,
  "evaluationCases": [
    {
      "name": "a schemas section changes no evaluation",
      "datafile": {
        "schemaVersion": "4",
        "revision": "1",
        "segments": {},
        "features": {
          "checkout": {
            "hash": "checkout-1",
            "bucketBy": "userId",
            "traffic": [
              {
                "key": "all",
                "conditions": "*",
                "percentage": 100000,
                "variation": "treatment"
              }
            ],
            "variablesSchema": {
              "label": {
                "type": "string",
                "defaultValue": "Pay"
              }
            },
            "variations": [
              {
                "value": "control"
              },
              {
                "value": "treatment",
                "variables": {
                  "label": "Pay now"
                }
              }
            ]
          },
          "off": {
            "hash": "off-1",
            "bucketBy": "userId",
            "traffic": []
          }
        },
        "variables": {
          "banner": {
            "hash": "banner-1",
            "type": "string",
            "defaultValue": "Hello"
          }
        },
        "schemas": {
          "signUp": {
            "hash": "signUp-1",
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              }
            },
            "required": [
              "email"
            ]
          }
        }
      },
      "context": {
        "userId": "user-1"
      },
      "results": [
        {
          "method": "isEnabled",
          "args": [
            "checkout"
          ],
          "value": true
        },
        {
          "method": "getVariation",
          "args": [
            "checkout"
          ],
          "value": "treatment"
        },
        {
          "method": "getVariable",
          "args": [
            "checkout",
            "label"
          ],
          "value": "Pay now"
        },
        {
          "method": "getVariable",
          "args": [
            "banner"
          ],
          "value": "Hello"
        },
        {
          "method": "isEnabled",
          "args": [
            "off"
          ],
          "value": false
        }
      ]
    },
