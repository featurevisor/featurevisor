{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "archived": { "type": "boolean" },
    "promotable": { "type": "boolean" },
    "description": { "type": "string" },
    "conditions": {
      "anyOf": [
        { "type": "string", "const": "*" },
        { "$ref": "#/definitions/__schema0" },
        { "minItems": 1, "type": "array", "items": { "$ref": "#/definitions/__schema0" } }
      ]
    }
  },
  "required": ["description", "conditions"],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "attribute": { "type": "string" },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "notEquals",
                "greaterThan",
                "greaterThanOrEquals",
                "lessThan",
                "lessThanOrEquals",
                "contains",
                "notContains",
                "startsWith",
                "endsWith",
                "matches",
                "notMatches",
                "semverEquals",
                "semverNotEquals",
                "semverGreaterThan",
                "semverGreaterThanOrEquals",
                "semverLessThan",
                "semverLessThanOrEquals",
                "before",
                "after",
                "in",
                "notIn",
                "includes",
                "notIncludes",
                "includesAny",
                "notIncludesAny",
                "exists",
                "notExists",
                "isNull",
                "notNull",
                "empty",
                "notEmpty"
              ]
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      { "type": "string" },
                      { "type": "number" },
                      { "type": "boolean" },
                      { "type": "null" }
                    ]
                  }
                },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "null" }
              ]
            },
            "regexFlags": { "type": "string" },
            "compareTo": { "not": {} }
          },
          "required": ["attribute", "operator"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "feature": { "type": "string", "minLength": 1 },
            "enabled": { "type": "boolean" },
            "variation": { "type": "string", "minLength": 1 }
          },
          "required": ["feature"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "feature": { "type": "string", "minLength": 1 },
            "variable": { "type": "string", "minLength": 1 },
            "path": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
                }
              ]
            },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "notEquals",
                "greaterThan",
                "greaterThanOrEquals",
                "lessThan",
                "lessThanOrEquals",
                "contains",
                "notContains",
                "startsWith",
                "endsWith",
                "matches",
                "notMatches",
                "semverEquals",
                "semverNotEquals",
                "semverGreaterThan",
                "semverGreaterThanOrEquals",
                "semverLessThan",
                "semverLessThanOrEquals",
                "before",
                "after",
                "in",
                "notIn",
                "includes",
                "notIncludes",
                "includesAny",
                "notIncludesAny",
                "exists",
                "notExists",
                "isNull",
                "notNull",
                "empty",
                "notEmpty"
              ]
            },
            "value": {
              "$comment": "Any JSON value is structurally allowed here. Run Featurevisor lint."
            },
            "regexFlags": { "type": "string", "pattern": "^[gims]+$" }
          },
          "required": ["variable", "operator"],
          "additionalProperties": false
        },
        { "type": "string", "minLength": 1, "pattern": "^(?!\\*$).+" },
        {
          "type": "object",
          "properties": {
            "and": {
              "minItems": 1,
              "type": "array",
              "items": { "$ref": "#/definitions/__schema0" }
            }
          },
          "required": ["and"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "or": { "minItems": 1, "type": "array", "items": { "$ref": "#/definitions/__schema0" } }
          },
          "required": ["or"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "minItems": 1,
              "type": "array",
              "items": { "$ref": "#/definitions/__schema0" }
            }
          },
          "required": ["not"],
          "additionalProperties": false
        }
      ]
    }
  }
}
